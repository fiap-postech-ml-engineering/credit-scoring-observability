# Copie para `.env` e ajuste o que precisar. Todas as chaves são opcionais:
# os padrões estão em src/config/settings.py.

# --- Rastreamento (MLflow) ---------------------------------------------------
# Local (padrão): SQLite no diretório do projeto.
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Com a stack do Docker Compose de pé:
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT=credit-scoring-observability

# --- Limiares de alerta de drift ---------------------------------------------
# PSI_ALERT_THRESHOLD=0.25
# PSI_WARN_THRESHOLD=0.10
# DRIFT_P_VALUE=0.05
# DATASET_DRIFT_SHARE=0.3
# AUC_DEGRADATION_THRESHOLD=0.03

# --- Modelo -------------------------------------------------------------------
# DECISION_THRESHOLD=0.5
# RANDOM_STATE=42
